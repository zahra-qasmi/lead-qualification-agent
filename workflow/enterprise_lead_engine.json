    {
      "parameters": {
        "jsCode": "const output = $input.item.json.output || $input.item.json.text || '{}';\nlet ai = {};\ntry {\n  const cleanJson = typeof output === 'string' ? output.replace(/```json|```/g, '').trim() : output;\n  ai = typeof cleanJson === 'string' ? JSON.parse(cleanJson) : cleanJson;\n} catch (e) {\n  ai = {\n    leadScore: 50,\n    priority: 'Warm',\n    intentSummary: 'Inquiry parsed via fallback mechanism.',\n    recommendedAction: 'Manual review required.'\n  };\n}\n\nconst original = $('Sanitize & Validate').item.json;\n\n// Slack color hex codes: Hot = Red (#E01E5A), Warm = Gold (#ECB22E), Cold = Blue (#2EB67D)\nlet colorHex = '#2EB67D';\nif (ai.priority === 'Hot') colorHex = '#E01E5A';\nelse if (ai.priority === 'Warm') colorHex = '#ECB22E';\n\nreturn [{\n  json: {\n    ...original,\n    qualification: ai,\n    slackColor: colorHex\n  }\n}];"
      },
      "id": "b7bc4d05-d4b4-4a1f-b27c-bf82239c7863",
