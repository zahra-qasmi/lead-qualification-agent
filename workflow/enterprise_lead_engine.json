    {
      "parameters": {
        "sendTo": "={{ $('Parse Groq Output').item.json.email }}",
        "subject": "=Inquiry Received - {{ $('Parse Groq Output').item.json.company }}",
        "message": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 32px 24px; color: #1e293b; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;\">\n  \n  <!-- Header / Status Badge -->\n  <div style=\"border-bottom: 2px solid #f1f5f9; padding-bottom: 20px; margin-bottom: 24px;\">\n    <span style=\"font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #475569; background: #f1f5f9; padding: 4px 10px; border-radius: 9999px;\">Inquiry Received</span>\n    <h2 style=\"font-size: 20px; font-weight: 800; color: #0f172a; margin: 12px 0 0 0; letter-spacing: -0.02em;\">Project Scope Under Review</h2>\n  </div>\n\n  <!-- Main Body -->\n  <p style=\"font-size: 15px; line-height: 1.6; color: #334155; margin: 0 0 16px 0;\">\n    Hi <strong>{{ $('Parse Groq Output').item.json.name }}</strong>,\n  </p>\n\n  <p style=\"font-size: 15px; line-height: 1.6; color: #334155; margin: 0 0 20px 0;\">\n    Thank you for submitting your project details regarding <strong>{{ $('Parse Groq Output').item.json.company }}</strong>. We have successfully logged your inquiry in our system.\n  </p>\n\n  <!-- Inquiry Callout Card -->\n  <div style=\"background-color: #f8fafc; border-left: 4px solid #94a3b8; padding: 14px 18px; border-radius: 4px; margin-bottom: 24px;\">\n    <p style=\"margin: 0; font-size: 13px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;\">Submitted Scope Details</p>\n    <p style=\"margin: 6px 0 0 0; font-size: 14px; color: #334155; font-style: italic;\">\n      \"{{ $('Parse Groq Output').item.json.inquiry }}\"\n    </p>\n  </div>\n\n  <!-- Clarification Questions -->\n  <p style=\"font-size: 15px; line-height: 1.6; color: #334155; margin: 0 0 12px 0;\">\n    To help our strategy team evaluate feasibility against your target budget and timeline, could you reply directly with brief answers to the following?\n  </p>\n\n  <ul style=\"font-size: 14px; line-height: 1.6; color: #475569; margin: 0 0 24px 0; padding-left: 20px;\">\n    <li style=\"margin-bottom: 6px;\"><strong>Timeline:</strong> What is your target deployment or launch date?</li>\n    <li style=\"margin-bottom: 6px;\"><strong>Deliverables:</strong> Are there any benchmark platforms or live examples you want to model after?</li>\n    <li><strong>Assets:</strong> Do you have existing technical requirements/designs, or is this being architected from scratch?</li>\n  </ul>\n\n  <p style=\"font-size: 14px; line-height: 1.6; color: #64748b; margin: 0 0 24px 0;\">\n    Once we receive your additional context, our team will review the specifications and follow up with a structured scope outline within <strong>24 business hours</strong>.\n  </p>\n\n  <!-- Signoff -->\n  <div style=\"border-top: 1px solid #f1f5f9; padding-top: 20px; margin-top: 24px;\">\n    <p style=\"margin: 0; font-size: 14px; font-weight: 700; color: #0f172a;\">Client Services Team</p>\n    <p style=\"margin: 2px 0 0 0; font-size: 12px; color: #94a3b8;\">Inbound Solutions & Scoping</p>\n  </div>\n</div>",
        "options": {}
      },
