    {
      "parameters": {
        "sendTo": "={{ $('Parse Groq Output').item.json.email }}",
        "subject": "=Consultation Booking - {{ $('Parse Groq Output').item.json.company }} Project",
        "message": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 32px 24px; color: #1e293b; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;\">\n  \n  <!-- Header / Brand -->\n  <div style=\"border-bottom: 2px solid #f1f5f9; padding-bottom: 20px; margin-bottom: 24px;\">\n    <span style=\"font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #4f46e5; background: #eef2ff; padding: 4px 10px; border-radius: 9999px;\">Project Discovery</span>\n    <h2 style=\"font-size: 20px; font-weight: 800; color: #0f172a; margin: 12px 0 0 0; letter-spacing: -0.02em;\">Consultation Request Confirmed</h2>\n  </div>\n\n  <!-- Body Content -->\n  <p style=\"font-size: 15px; line-height: 1.6; color: #334155; margin: 0 0 16px 0;\">\n    Hi <strong>{{ $('Parse Groq Output').item.json.name }}</strong>,\n  </p>\n\n  <p style=\"font-size: 15px; line-height: 1.6; color: #334155; margin: 0 0 20px 0;\">\n    Thank you for submitting your project specifications for <strong>{{ $('Parse Groq Output').item.json.company }}</strong>. Our technical architecture team has reviewed your scope and target milestones.\n  </p>\n\n  <!-- Project Summary Box -->\n  <div style=\"background-color: #f8fafc; border-left: 4px solid #4f46e5; padding: 14px 18px; border-radius: 4px; margin-bottom: 24px;\">\n    <p style=\"margin: 0; font-size: 13px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;\">Initial Scope Summary</p>\n    <p style=\"margin: 6px 0 0 0; font-size: 14px; color: #1e293b; font-style: italic;\">\n      \"{{ $('Parse Groq Output').item.json.inquiry }}\"\n    </p>\n  </div>\n\n  <p style=\"font-size: 15px; line-height: 1.6; color: #334155; margin: 0 0 24px 0;\">\n    To ensure we align on deliverables, technical requirements, and execution timelines, we would like to invite you to an introductory <strong>30-minute discovery session</strong>.\n  </p>\n\n  <!-- CTA Button -->\n  <div style=\"text-align: left; margin: 28px 0;\">\n    <a href=\"https://cal.com/consultation-booking\" style=\"background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 600; display: inline-block; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);\">\n      Reserve Your Consultation Slot &rarr;\n    </a>\n  </div>\n\n  <p style=\"font-size: 13px; line-height: 1.5; color: #64748b; margin: 0 0 24px 0;\">\n    <em>If you have reference documentation, system diagrams, or wireframes prepared, feel free to reply directly to this thread with attachments.</em>\n  </p>\n\n  <!-- Footer / Signoff -->\n  <div style=\"border-top: 1px solid #f1f5f9; padding-top: 20px; margin-top: 24px;\">\n    <p style=\"margin: 0; font-size: 14px; font-weight: 700; color: #0f172a;\">Executive Solutions Team</p>\n    <p style=\"margin: 2px 0 0 0; font-size: 12px; color: #94a3b8;\">Client Architecture & Strategy</p>\n  </div>\n</div>",
        "options": {}
      },
