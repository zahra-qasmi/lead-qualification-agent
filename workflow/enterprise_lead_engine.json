    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze and qualify this incoming project lead strictly into raw JSON (no markdown ticks or surrounding conversational text):\n\nLead Details:\n- Name: {{ $json.name }}\n- Company: {{ $json.company }}\n- Budget: ${{ $json.budget }}\n- Inquiry: {{ $json.inquiry }}\n\nReturn JSON Schema:\n{\n  \"leadScore\": number (1-100),\n  \"priority\": \"Hot\" | \"Warm\" | \"Cold\",\n  \"intentSummary\": string,\n  \"recommendedAction\": string\n}",
        "options": {
          "systemMessage": "You are an autonomous AI Sales Agent. Your job is to strictly analyze the intent, scope, and budget of incoming leads and return structured evaluation JSON with leadScore, priority, intentSummary, and recommendedAction."
        }
      },
      "id": "04538943-6567-4935-ab74-8cb822744293",
      "name": "AI Lead Qualification Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -1472,
        -464
