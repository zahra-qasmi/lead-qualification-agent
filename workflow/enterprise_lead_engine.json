        "url": "={{ $env.SLACK_WEBHOOK_URL || 'https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  JSON.stringify({\n    \"attachments\": [\n      {\n        \"color\": $('Parse Groq Output').item.json.slackColor || \"#2EB67D\",\n        \"blocks\": [\n          {\n            \"type\": \"header\",\n            \"text\": {\n              \"type\": \"plain_text\",\n              \"text\": ($('Parse Groq Output').item.json.qualification.priority === \"Hot\" ? \"🔥 HOT Lead Alert\" : \"📋 New Lead Qualified\") + \" - \" + $('Parse Groq Output').item.json.company,\n              \"emoji\": true\n            }\n          },\n          {\n            \"type\": \"section\",\n            \"fields\": [\n              {\n                \"type\": \"mrkdwn\",\n                \"text\": \"*👤 Contact:*\\n\" + $('Parse Groq Output').item.json.name + \"\\n\" + $('Parse Groq Output').item.json.email + \"\\n\" + $('Parse Groq Output').item.json.phone\n              },\n              {\n                \"type\": \"mrkdwn\",\n                \"text\": \"*💰 Budget & Score:*\\n*Budget:* $\" + $('Parse Groq Output').item.json.budget + \"\\n*Score:* \" + $('Parse Groq Output').item.json.qualification.leadScore + \"/100\\n*Priority:* `\" + $('Parse Groq Output').item.json.qualification.priority + \"`\"\n              }\n            ]\n          },\n          {\n            \"type\": \"section\",\n            \"text\": {\n              \"type\": \"mrkdwn\",\n              \"text\": \"*🤖 AI Summary:*\\n\" + $('Parse Groq Output').item.json.qualification.intentSummary\n            }\n          },\n          {\n            \"type\": \"section\",\n            \"text\": {\n              \"type\": \"mrkdwn\",\n              \"text\": \"*🎯 Recommended Next Step:*\\n\" + $('Parse Groq Output').item.json.qualification.recommendedAction\n            }\n          },\n          {\n            \"type\": \"context\",\n            \"elements\": [\n              {\n                \"type\": \"mrkdwn\",\n                \"text\": \"📝 *Inquiry:* \\\"\" + $('Parse Groq Output').item.json.inquiry + \"\\\" • \" + $('Parse Groq Output').item.json.receivedAt\n              }\n            ]\n          }\n        ]\n      }\n    ]\n  })\n}}",
        "options": {}
