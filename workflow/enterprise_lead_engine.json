    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\n\nconst name = (body.name || '').trim();\nconst email = (body.email || '').trim().toLowerCase();\nconst phone = (body.phone || 'N/A').trim();\nconst company = (body.company || 'Individual').trim();\nconst inquiry = (body.inquiry || '').trim();\nconst budget = Number(body.budget) || 0;\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst isValid = emailRegex.test(email) && name.length >= 2;\n\nreturn [{\n  json: {\n    isValid,\n    name,\n    email,\n    phone,\n    company,\n    inquiry,\n    budget,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "faa4bc26-eb29-4a50-905f-f18ed81669e8",
